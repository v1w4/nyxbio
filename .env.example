# senha do painel admin (obrigatória)
ADMIN_PASSWORD=troque-essa-senha
# chave segredo pra assinar o cookie de login (qualquer texto longo)
SESSION_SECRET=coloque-um-texto-longo-aleatorio
# chave da API da Anthropic (fica só no servidor, nunca no HTML)
ANTHROPIC_API_KEY=sk-ant-...
# modelo usado pelo assistente
ANTHROPIC_MODEL=claude-haiku-5-5
# orçamento mensal de tokens (entrada + saída) para o assistente
TOKEN_BUDGET=500000
# caminho do banco (use um disco persistente em produção)
DB_PATH=./data.sqlite
PORT=3000
